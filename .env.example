# ==============================================================================
# BugBounty-AI Environment Configuration
# ==============================================================================

# Database
BUGBOUNTY_DATABASE_URL=sqlite:///data/bugbounty.db

# Global Defaults & Operating Mode
# Options: PASSIVE, ACTIVE_RECON, VALIDATION, MANUAL_ASSIST, DRY_RUN, LAB
BUGBOUNTY_DEFAULT_MODE=PASSIVE

# Safety & Rate Limiting
BUGBOUNTY_DEFAULT_RPS=2.0
BUGBOUNTY_DEFAULT_RPM=60.0
BUGBOUNTY_MAX_CONCURRENCY=2
BUGBOUNTY_COMMAND_TIMEOUT=30

# Logging & Redaction
BUGBOUNTY_LOG_LEVEL=INFO
BUGBOUNTY_LOG_FILE=logs/audit.jsonl
BUGBOUNTY_REDACT_SECRETS=true

# AI Provider Configuration (Clean Interfaces for Phase 5+)
# Options: mock, openai, gemini, local_llm
BUGBOUNTY_AI_PROVIDER=mock
BUGBOUNTY_AI_API_KEY=
BUGBOUNTY_AI_MODEL=
